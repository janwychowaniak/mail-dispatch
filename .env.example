# Every variable of mail-dispatch (docs/SPEC.md §7.1). Only SMTP_HOST is required; an empty
# variable means the same as an unset one. Copy to .env, which git ignores, and fill in.

# The one SMTP server this instance sends through.
SMTP_HOST=smtp.example.org
# 587 by default; set 465 for SMTP_TLS=implicit.
SMTP_PORT=587
# starttls (TLS required) | starttls-opportunistic | implicit | none
SMTP_TLS=starttls
# Certificate verification; false also disables the name check (and SMTP_CA_FILE).
SMTP_TLS_VERIFY=true
# An own certificate authority, added to the system's trusted ones.
SMTP_CA_FILE=

# Credentials travel only under TLS. Prefer SMTP_PASSWORD_FILE (a mounted secret) to
# SMTP_PASSWORD; never set both.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=

# The name presented in EHLO; the container's hostname by default. Some servers refuse a
# name without a dot.
SMTP_EHLO_NAME=
# The idle limit of every socket operation, and the deadline of the connect stage.
SMTP_TIMEOUT_SECONDS=60
# The domain in Message-ID; the sender's domain by default.
MESSAGE_ID_DOMAIN=

MAX_REQUEST_BYTES=33554432
MAX_MESSAGE_BYTES=26214400
MAX_RECIPIENTS=100
HEALTH_CACHE_TTL_SECONDS=10
HEALTH_PROBE_TIMEOUT_SECONDS=5
PORT=8000
LOG_LEVEL=INFO
